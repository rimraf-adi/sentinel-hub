{
  "name": "Sentinel Hub Registry",
  "version": "1.0",
  "cdn_base": "https://raw.githubusercontent.com/rimraf-adi/sentinel-hub/main",
  "repository": "https://github.com/rimraf-adi/sentinel-hub",
  "description": "Templates, modular blocks, and capability packs for Sentinel ML control plane",
  "modules": [
    {
      "id": "vit-tiny",
      "component_id": "vision/vit-tiny@v1",
      "name": "ViT Tiny",
      "domain": "vision",
      "path": "modules/vision/vit-tiny.yaml",
      "description": "Compact vision transformer for image classification",
      "tags": ["vision", "transformer", "attention", "patch"]
    },
    {
      "id": "unet",
      "component_id": "vision/unet@v1",
      "name": "U-Net",
      "domain": "vision",
      "path": "modules/vision/unet.yaml",
      "description": "Encoder-decoder with skip connections for segmentation",
      "tags": ["vision", "segmentation", "skip-connections", "medical"]
    },
    {
      "id": "resnet-mini",
      "component_id": "vision/resnet-mini@v1",
      "name": "ResNet Mini",
      "domain": "vision",
      "path": "modules/vision/resnet-mini.yaml",
      "description": "Small residual CNN for image tasks",
      "tags": ["vision", "residual", "convolution", "resnet"]
    },
    {
      "id": "cnn-classifier",
      "component_id": "vision/cnn-classifier@v1",
      "name": "CNN Classifier",
      "domain": "vision",
      "path": "modules/vision/cnn-classifier.yaml",
      "description": "Convolutional baseline with batch norm and pooling",
      "tags": ["vision", "cnn", "classification", "baseline"]
    },
    {
      "id": "transformer-classifier",
      "component_id": "sequence/transformer-classifier@v1",
      "name": "Transformer Classifier",
      "domain": "sequence",
      "path": "modules/sequence/transformer-classifier.yaml",
      "description": "Multi-head attention classifier for sequences",
      "tags": ["sequence", "transformer", "attention", "nlp"]
    },
    {
      "id": "lstm-classifier",
      "component_id": "sequence/lstm-classifier@v1",
      "name": "LSTM Classifier",
      "domain": "sequence",
      "path": "modules/sequence/lstm-classifier.yaml",
      "description": "Recurrent baseline for text and time series",
      "tags": ["sequence", "lstm", "recurrent", "time-series"]
    },
    {
      "id": "residual-mlp",
      "component_id": "tabular/residual-mlp@v1",
      "name": "Residual MLP",
      "domain": "tabular",
      "path": "modules/tabular/residual-mlp.yaml",
      "description": "Tabular network with skip connections and layer norm",
      "tags": ["tabular", "mlp", "residual", "classification"]
    },
    {
      "id": "deep-residual-mlp",
      "component_id": "tabular/deep-residual-mlp@v1",
      "name": "Deep Residual MLP",
      "domain": "tabular",
      "path": "modules/tabular/deep-residual-mlp.yaml",
      "description": "Multi-stage residual network for complex tabular data",
      "tags": ["tabular", "deep", "residual", "multi-stage"]
    },
    {
      "id": "ann-classifier",
      "component_id": "tabular/ann-classifier@v1",
      "name": "ANN Classifier",
      "domain": "tabular",
      "path": "modules/tabular/ann-classifier.yaml",
      "description": "Dense feed-forward baseline for tabular data",
      "tags": ["tabular", "dense", "baseline", "classification"]
    },
    {
      "id": "vae",
      "component_id": "generative/vae@v1",
      "name": "Variational Autoencoder",
      "domain": "generative",
      "path": "modules/generative/vae.yaml",
      "description": "Latent-variable generative model",
      "tags": ["generative", "vae", "latent", "reparameterization"]
    },
    {
      "id": "gan",
      "component_id": "generative/gan@v1",
      "name": "GAN",
      "domain": "generative",
      "path": "modules/generative/gan.yaml",
      "description": "Generator and discriminator pair for sample generation",
      "tags": ["generative", "gan", "adversarial", "synthesis"]
    },
    {
      "id": "gcn-classifier",
      "component_id": "graph/gcn-classifier@v1",
      "name": "GCN Classifier",
      "domain": "graph",
      "path": "modules/graph/gcn-classifier.yaml",
      "description": "Graph convolution for node and graph classification",
      "tags": ["graph", "gcn", "spectral", "node-classification"]
    },
    {
      "id": "kan-linear",
      "component_id": "experimental/kan-linear@v1",
      "name": "KAN Linear (experimental)",
      "domain": "experimental",
      "path": "modules/experimental/kan-linear.yaml",
      "description": "Learnable spline activations in place of fixed weights",
      "tags": ["experimental", "kan", "spline", "learnable-activation"]
    },
    {
      "id": "mamba-ssm",
      "component_id": "experimental/mamba-ssm@v1",
      "name": "Mamba SSM (experimental)",
      "domain": "experimental",
      "path": "modules/experimental/mamba-ssm.yaml",
      "description": "State-space model with linear scaling in sequence length",
      "tags": ["experimental", "mamba", "ssm", "linear-attention"]
    }
  ]
}
